{
  "name": "cv-presentation-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for a university Computer Vision presentation schedule, running on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cv-presentation --local",
    "db:migrate:remote": "wrangler d1 migrations apply cv-presentation --remote",
    "webhook:set": "node scripts/set-webhook.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
